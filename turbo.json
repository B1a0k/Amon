{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".npmrc",
    ".github/actions/setup-bun/**",
    ".github/workflows/test.yml"
  ],
  "globalEnv": [
    "CI",
    "AMON_DISABLE_SHARE"
  ],
  "globalPassThroughEnv": [
    "CI",
    "AMON_DISABLE_SHARE"
  ],
  "tasks": {
    "typecheck": {},
    "@opencode/cli#typecheck": {
      "dependsOn": [
        "@opencode/core#typecheck"
      ]
    },
    "test:components": {
      "outputs": [],
      "cache": false
    },
    "@opencode/server#typecheck": {
      "dependsOn": [
        "@opencode/core#typecheck"
      ]
    },
    "@opencode/simulation#typecheck": {
      "dependsOn": [
        "@opencode/core#typecheck"
      ]
    },
    "build": {
      "dependsOn": [],
      "outputs": [
        "dist/**"
      ]
    },
    "@opencode/ai#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@opencode/codemode#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@opencode/core#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@opencode/desktop#test": {
      "outputs": [],
      "cache": false
    },
    "@opencode/httpapi-codegen#test": {
      "outputs": []
    },
    "@opencode/server#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@opencode/cli#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@opencode/app#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@opencode/ui#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@opencode/session-ui#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
