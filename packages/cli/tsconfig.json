{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true
  },
  "exclude": [
    "dist",
    "dist-node"
  ],
  "references": [
    {
      "path": "../core"
    }
  ],
  "include": [
    "src",
    "script",
    "vite.node.config.ts"
  ]
}
