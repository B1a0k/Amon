{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "amon",
  "description": "Amon (阿蒙): desktop AI agent based on OpenCode",
  "version": "2.0.27",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "node script/run-bun.mjs dev",
    "setup": "node script/run-bun.mjs install",
    "dev:desktop": "node script/run-bun.mjs dev",
    "dev:engine": "node script/run-bun.mjs engine",
    "build:engine": "node script/run-bun.mjs build-engine",
    "build": "node script/run-bun.mjs build",
    "package:desktop": "node script/run-bun.mjs package",
    "lint": "oxlint && ast-grep scan -c script/ast-grep/gui-extensions/sgconfig.yml && bun script/sdk-docs.ts",
    "typecheck": "bun turbo typecheck --concurrency=3",
    "check": "node script/run-bun.mjs check",
    "check:internal": "bun run lint && bun run typecheck",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "test": "echo 'run tests from package directories' && exit 1",
    "lint:changed": "bun script/lint-changed.ts"
  },
  "workspaces": {
    "packages": [
      "packages/ai",
      "packages/amon-native",
      "packages/app",
      "packages/cli",
      "packages/client",
      "packages/codemode",
      "packages/core",
      "packages/desktop",
